#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
BIN="${TRIM_APPDEST}/localsend-nas"
DATA_DIR="${TRIM_PKGVAR}"

# 接收目录：优先用飞牛自动创建的共享目录（已自动授权应用用户读写，并可在文件管理器浏览）
get_share_dir() {
    if [ -n "$TRIM_DATA_SHARE_PATHS" ]; then
        local first
        first=$(echo "$TRIM_DATA_SHARE_PATHS" | awk '{print $1}')
        if [ -n "$first" ]; then
            echo "$first"
            return 0
        fi
    fi
    if [ -d "/var/apps/${TRIM_APPNAME}/share/localsend" ]; then
        echo "/var/apps/${TRIM_APPNAME}/share/localsend"
        return 0
    fi
    echo "${TRIM_PKGVAR}/inbox"
}

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

start_process() {
    if status; then
        return 0
    fi

    local SHARE_DIR
    SHARE_DIR=$(get_share_dir)
    mkdir -p "$SHARE_DIR"

    # 读取用户配置的 Web 端口（安装/配置向导写入），默认 8080
    local WEB_PORT
    WEB_PORT=$(cat "${TRIM_PKGVAR}/web_port" 2>/dev/null)
    if ! echo "$WEB_PORT" | grep -qE '^[0-9]{1,5}$'; then
        WEB_PORT=8080
    fi

    log_msg "Starting process, share=$SHARE_DIR, port=$WEB_PORT ..."
    # -receive-dir 将接收目录注册为 "inbox" 共享，并作为默认接收保存路径；
    # 用户可在网页设置面板（接收目录）里实时修改，改后立即生效。
    CMD="exec ${BIN} -listen :${WEB_PORT} -data-dir \"${DATA_DIR}\" -receive-dir \"${SHARE_DIR}\" -alias \"fnOS-NAS\""
    bash -c "${CMD}" >> ${LOG_FILE} 2>&1 &
    printf "%s" "$!" > ${PID_FILE}
    return 0
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')

        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1"
            return
        fi

        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM ${pid} >> ${LOG_FILE} 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
            rm -f "${PID_FILE}"
        else
            log_msg "process killed... "
        fi
    fi

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi
    fi
    return 1
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
